load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

# `bazel build //Examples/GlassifyDemo:GlassifyDemo` builds the example app with Bazel.
swift_library(
    name = "GlassifyDemoLib",
    srcs = glob(["Sources/*.swift"]),
    module_name = "GlassifyDemo",
    deps = ["//:Glassify"],
)

ios_application(
    name = "GlassifyDemo",
    bundle_id = "dev.glassify.example",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    deps = [":GlassifyDemoLib"],
)
